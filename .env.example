# Copy to .env and fill in your keys (never commit .env).

# NextAuth / Auth.js + Google OAuth
# https://console.cloud.google.com/apis/credentials
NEXTAUTH_SECRET=
# Must match your dev server origin (check terminal port — often 3000 or 5173)
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js v5 — auto-mapped from NEXTAUTH_* / GOOGLE_* at runtime (do not remove)
# AUTH_SECRET=
# AUTH_URL=http://localhost:3000/api/auth
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Required on Vercel/Cloudflare (also set automatically in auth.env.ts):
AUTH_TRUST_HOST=true

GEMINI_API_KEY=
# Trip plan generation (default: gemini-2.5-flash — ~2–4¢/plan vs ~15¢ on 3.5-flash)
GEMINI_TRIP_PLAN_MODEL=gemini-2.5-flash
BOOKING_API_KEY=
MAPBOX_PUBLIC_TOKEN=

# Unsplash — free tier for POI / map marker photos
# https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=

# Supabase — auth + quota (required in production)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Hero flight search (/api/search)
# Default: OpenAI parses the query → Duffel offers → OpenAI ranks top 3.
#
# When MAKE_WEBHOOK_URL is set, /api/search forwards to Make.com instead:
#   POST {
#     userMessage,
#     latitude?, longitude?,
#     parsedData: {
#       origin_airports: ["LJU","ZAG","VIE"],
#       destination_airport: "BKK",
#       departure_date: "2026-10-15",
#       return_date: "2026-10-29",
#       passengers: { adults: 2, children: 1 }
#     }
#   }
# Make.com HTTP module: origin {{1.parsedData.origin_airports[0]}}, dest {{1.parsedData.destination_airport}}
#
# Async pattern (scenario >10s):
#   1) Search webhook returns "Accepted" immediately; scenario saves offers to Data Store under searchId
#   2) Set MAKE_STATUS_WEBHOOK_URL to a second Make webhook that reads Data Store by { searchId }
#   3) Frontend polls GET /api/search/status?searchId=... until offers are ready
#   Response { offers: [{ rank, badge, origin_iata, destination_iata, ... }] }
OPENAI_API_KEY=
DUFFEL_API_KEY=
MAKE_WEBHOOK_URL=
MAKE_STATUS_WEBHOOK_URL=
