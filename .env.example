# Copy to .env and fill in your keys (never commit .env).

# Google OAuth (used by Supabase Auth → Authentication → Providers → Google)
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must include:
#   https://<project-ref>.supabase.co/auth/v1/callback
# And Supabase redirect allow-list must include:
#   https://www.skybooplan.com/auth/callback
#   http://localhost:8080/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional legacy Auth.js (not used for Google login buttons anymore)
NEXTAUTH_SECRET=
# Must match your dev server origin (check terminal port — often 3000 or 5173)
NEXTAUTH_URL=http://localhost:3000

# Auth.js v5 — auto-mapped from NEXTAUTH_* / GOOGLE_* at runtime (do not remove)
# AUTH_SECRET=
# AUTH_URL=http://localhost:3000/api/auth
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Required on Vercel/Cloudflare (also set automatically in auth.env.ts):
AUTH_TRUST_HOST=true

GEMINI_API_KEY=
# Trip plan generation (default: gemini-2.5-flash — ~2–4¢/plan vs ~15¢ on 3.5-flash)
GEMINI_TRIP_PLAN_MODEL=gemini-2.5-flash
BOOKING_API_KEY=
# Booking.com Partner Hub aid (legacy). Live tracking is CJ — set both on Vercel.
BOOKING_AFFILIATE_ID=
VITE_BOOKING_AFFILIATE_ID=
# CJ Affiliate: Home Page text-link from CJ → Partners → Booking.com CEE → Links
# Example: https://www.anrdoezrs.net/click-YOURPID-YOURADID
CJ_CLICK_URL=
VITE_CJ_CLICK_URL=
# Optional label copied from the same CJ homepage link (?label=...)
BOOKING_AFFILIATE_LABEL=
VITE_BOOKING_AFFILIATE_LABEL=
MAPBOX_PUBLIC_TOKEN=

# Unsplash — free tier for POI / map marker photos
# https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=

# Supabase — auth + quota (required in production)
# On Vercel, set BOTH server + Vite names (client Google OAuth needs VITE_*):
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Hero flight search (/api/search)
# Default: OpenAI parses the query → Duffel offers (direct) → OpenAI ranks top 3.
# Requires DUFFEL_API_KEY. Do NOT set MAKE_FLIGHT_SEARCH_PRIMARY in production.
#
# Opt-in Make.com path (legacy / experiments only):
#   MAKE_FLIGHT_SEARCH_PRIMARY=1
#   MAKE_WEBHOOK_URL=https://hook.eu1.make.com/...
# When primary Make fails (error / empty / timeout path), server falls back to direct Duffel once.
#
# Make webhook payload (when primary):
#   POST {
#     userMessage,
#     latitude?, longitude?,
#     parsedData: {
#       origin_airports: ["LJU","ZAG","VIE"],
#       destination_airport: "BKK",
#       departure_date: "2026-10-15",
#       return_date: "2026-10-29",
#       passengers: { adults: 2, children: 1 }
#     }
#   }
# Async pattern (scenario >10s):
#   1) Search webhook returns "Accepted"; scenario saves offers to Data Store under searchId
#   2) MAKE_STATUS_WEBHOOK_URL reads Data Store by { searchId }
#   3) Frontend polls GET /api/search/status?searchId=...
OPENAI_API_KEY=
DUFFEL_API_KEY=
# MAKE_FLIGHT_SEARCH_PRIMARY=0
MAKE_WEBHOOK_URL=
MAKE_STATUS_WEBHOOK_URL=
