# Copy to .env and fill in your keys (never commit .env).

# NextAuth / Auth.js + Google OAuth
# https://console.cloud.google.com/apis/credentials
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js v5 aliases (optional — auto-mapped from NEXTAUTH_* above)
# AUTH_SECRET=
# AUTH_URL=http://localhost:3000/api/auth

GEMINI_API_KEY=
BOOKING_API_KEY=
MAPBOX_PUBLIC_TOKEN=
DUFFEL_API_KEY=

# Unsplash — free tier for POI / map marker photos
# https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=
